# Copy this file to .env and fill in your values. .env is git-ignored; this template is not.

# ------------------------------------------------------------------
# Database (Neon) — Neon console > Connect
# ------------------------------------------------------------------
# The connection string from Neon (pooled or direct — both work).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------
# WhatsApp Cloud API — Meta App Dashboard > WhatsApp > API Setup
# ------------------------------------------------------------------
WA_VERIFY_TOKEN="any-random-string-you-also-type-into-meta"
WA_APP_SECRET=""              # App Settings > Basic > App Secret
WA_ACCESS_TOKEN=""            # System-user permanent token
WA_PHONE_NUMBER_ID=""
WA_BUSINESS_ACCOUNT_ID=""
WA_GRAPH_VERSION="v26.0"
WA_APP_ID=""                  # Optional. Meta App ID, for uploading template header samples (looked up from the token if empty)

# ------------------------------------------------------------------
# Marketing: campaigns + opt-ins
# ------------------------------------------------------------------
# Shared secret for /api/cron/campaigns. Put the same value in GitHub (Settings → Secrets →
# Actions → CRON_SECRET). Generate one with: openssl rand -hex 32
CRON_SECRET=""
# Key your systems use for this app's API: API campaigns (docs/API.md) and the opt-in API
# (docs/OPT_IN_API.md). OPTIN_API_KEY from older setups still works.
API_KEY=""

# ------------------------------------------------------------------
# Your chatbot — TURNED OFF for now (see src/lib/enabled-channels.ts).
# Uncomment when you turn it on. Contract: docs/BOT_INTEGRATION.md
# ------------------------------------------------------------------
# BOT_INGEST_SECRET="shared-secret-between-chatcmsadv-and-your-bot"
# BOT_CALLBACK_URL=""         # We POST your replies + handoff events here
