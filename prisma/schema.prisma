// ChatCMS Adv data model.
// Every channel (your chatbot, WhatsApp, ...) is stored in the same
// Contact / Conversation / Message tables, so the inbox treats them all the same way.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma7.config.ts (migrations) and src/lib/db.ts (runtime).
datasource db {
  provider = "postgresql"
}

enum Channel {
  WEB_BOT
  WHATSAPP
}

enum ConversationStatus {
  BOT // your chatbot is answering
  HUMAN // you took over from the dashboard (bot is paused)
  CLOSED
}

enum Direction {
  IN // from the customer
  OUT // from our side (bot or you)
}

// Who wrote a message.
enum SenderType {
  CUSTOMER // the person chatting with your business
  BOT // your chatbot's automatic reply
  HUMAN // you, replying from the dashboard
  CAMPAIGN // a broadcast template sent by a campaign
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// Marketing consent. WhatsApp only allows marketing templates to people who opted in.
enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

// The customer. Created on their first message, or by a CSV import / the opt-in API.
model Contact {
  id                 String              @id @default(cuid())
  name               String?
  phone              String?
  email              String?
  // WhatsApp id: the phone number's digits incl. country code, no "+". One contact per number.
  waId               String?             @unique
  tags               String[]            @default([])
  // Custom fields (from CSV columns / the opt-in API), usable in campaign templates.
  attributes         Json                @default("{}")
  optInStatus        OptInStatus         @default(UNKNOWN)
  optInSource        String? // csv | manual | api | keyword
  optInAt            DateTime?
  optOutAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  conversations      Conversation[]
  consentEvents      ConsentEvent[]
  campaignRecipients CampaignRecipient[]
  paymentRequests    PaymentRequest[]

  @@index([optInStatus])
}

// Every opt-in / opt-out, for the audit trail and the audience growth chart.
model ConsentEvent {
  id        String      @id @default(cuid())
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    OptInStatus // OPTED_IN or OPTED_OUT
  source    String // csv | manual | api | keyword
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

model Conversation {
  id              String             @id @default(cuid())
  channel         Channel
  // Chatbot: your bot's conversation/session id. WhatsApp: the customer's wa_id (phone).
  externalId      String
  contactId       String
  contact         Contact            @relation(fields: [contactId], references: [id])
  status          ConversationStatus @default(BOT)
  lastMessageAt   DateTime           @default(now())
  lastMessageText String?
  // Time of the customer's last message. WhatsApp only allows free-text replies
  // within 24h of this; after that you must send an approved template.
  lastInboundAt   DateTime?
  unreadCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  messages        Message[]

  @@unique([channel, externalId])
  @@index([lastMessageAt(sort: Desc)])
}

model Message {
  id                String             @id @default(cuid())
  conversationId    String
  conversation      Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         Direction
  senderType        SenderType
  // text | image | audio | video | document | sticker | location | interactive | reaction | template | other
  type              String             @default("text")
  body              String?
  mediaId           String? // WhatsApp media id (shown via /api/media/[mediaId])
  mediaUrl          String? // direct URL (chatbot attachments)
  mimeType          String?
  raw               Json? // original payload, handy for debugging
  // WhatsApp wamid, or "bot:<id>" for your bot. Unique, so a resent webhook never creates a duplicate.
  externalId        String?            @unique
  status            MessageStatus      @default(SENT)
  error             String?
  createdAt         DateTime           @default(now())
  // Set when this message was sent by a campaign.
  campaignRecipient CampaignRecipient?

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Marketing: segments, campaigns, recipients
// ---------------------------------------------------------------------------

// A saved audience. `rules` (see src/lib/segments.ts) is evaluated at send time,
// always limited to opted-in WhatsApp contacts.
model Segment {
  id          String     @id @default(cuid())
  name        String
  description String?
  rules       Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

enum CampaignStatus {
  SCHEDULED // broadcast waiting for scheduledAt
  SENDING
  COMPLETED
  CANCELLED
  FAILED // stopped by an error that affects every message (expired token, template disabled…)
  LIVE // API campaign: sends whenever it's triggered
  PAUSED // API campaign switched off
}

enum CampaignType {
  BROADCAST // one template to an audience, now or scheduled
  API // sent to one contact at a time: auto-reply to incoming messages, or called by your systems
}

// A campaign: one approved template, sent as a broadcast or on demand (API).
model Campaign {
  id               String              @id @default(cuid())
  name             String
  type             CampaignType        @default(BROADCAST)
  status           CampaignStatus      @default(SCHEDULED)
  // API campaigns: when to send automatically (see src/lib/marketing/api-campaigns.ts).
  trigger          Json?
  templateName     String
  templateLanguage String
  templateCategory String?
  // Snapshot of the template when the campaign was created (see src/lib/templates.ts).
  template         Json
  // How each placeholder is filled for every recipient.
  variables        Json
  segmentId        String?
  segment          Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  audienceSize     Int?
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  lastError        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  recipients       CampaignRecipient[]
  paymentRequests  PaymentRequest[]

  @@index([status, scheduledAt])
  @@index([type, status])
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED // not sent: opted out meanwhile, or the campaign was cancelled / stopped
}

// One contact in one campaign. The timestamps drive the engagement funnel.
model CampaignRecipient {
  id             String          @id @default(cuid())
  campaignId     String
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status         RecipientStatus @default(PENDING)
  messageId      String?         @unique
  message        Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  error          String?
  errorCode      Int?
  claimedAt      DateTime? // when a sender picked it up (to recover from crashes)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  repliedAt      DateTime?
  buttonAt       DateTime? // tapped a quick-reply button
  buttonText     String?
  optedOutAt     DateTime? // opted out in reply to this campaign
  // API campaigns: placeholder values given for this one send, and what triggered it.
  params         Json?
  source         String? // incoming | api
  createdAt      DateTime        @default(now())
  paymentRequest PaymentRequest?

  // Broadcasts have one row per contact; API campaigns one per send (a contact can get it again).
  @@index([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId, sentAt])
}

// ---------------------------------------------------------------------------
// Payments: collect money from customers with payment links (Razorpay)
// ---------------------------------------------------------------------------

enum PaymentStatus {
  CREATED // link created, not paid yet
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

model PaymentRequest {
  id                  String             @id @default(cuid())
  contactId           String
  contact             Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  // Set when the link went out in a campaign.
  campaignId          String?
  campaign            Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignRecipientId String?            @unique
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id], onDelete: SetNull)
  amount              Int // in the currency's smallest unit (paise)
  amountPaid          Int                @default(0)
  currency            String             @default("INR")
  description         String
  status              PaymentStatus      @default(CREATED)
  provider            String             @default("razorpay")
  providerLinkId      String?            @unique // plink_…
  providerPaymentId   String?
  paymentMethod       String? // upi | card | netbanking | …
  shortUrl            String?
  sentVia             String? // chat | campaign | manual
  expiresAt           DateTime?
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([campaignId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Templates written in this app (drafts, and a record of what was submitted)
// ---------------------------------------------------------------------------

model TemplateDraft {
  id             String    @id @default(cuid())
  name           String    @default("")
  language       String    @default("en")
  category       String    @default("MARKETING")
  data           Json // the editor's draft (src/lib/marketing/template-builder.ts)
  metaTemplateId String? // set once submitted to WhatsApp
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([metaTemplateId])
}

// App settings (message rates for cost estimates, payment options…), one JSON value per key.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
